{
  "$schema": "../schemas/action.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.action.passkey.begin-pending-registration",
  "name": "Begin Pending Passkey Registration",
  "summary": "Issues a short-lived passkey creation challenge bound to a PendingIdentity without creating a durable user.",
  "version": 1,
  "maturity": "proposed",
  "requiredInputs": [{ "key": "pending-identity-reference", "valueType": "reference", "required": true, "description": "PendingIdentity receiving the registration challenge." }],
  "guards": [{ "expression": "pending-identity-flow == passkey", "failureCode": "passkey-flow-required" }],
  "permittedMutations": ["credential-proof"],
  "requiredEffects": ["create-short-lived-passkey-challenge", "bind-challenge-to-pending-identity"],
  "forbiddenEffects": ["create-durable-user", "persist-passkey-credential", "grant-normal-application-authorization"],
  "invariantKeys": ["auth.invariant.pending-identity.no-normal-authorization", "auth.invariant.pending-identity.exactly-one-flow", "auth.invariant.transition.one-state-changing-action", "auth.invariant.transition.deterministic-post-state"],
  "sourceReferences": [{ "sourceType": "code", "reference": "src/LagoVista.AspNetCore.Identity/Managers/AppUserPasskeyManager.cs", "note": "BeginPasswordlessRegistrationOptionsAsync challenge behavior" }, { "sourceType": "discussion", "reference": "AUTH-MODEL-GUIDE.md", "section": "4.8" }]
}