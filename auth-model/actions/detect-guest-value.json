{
  "$schema": "../schemas/action.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.action.guest.detect-value",
  "name": "Detect Guest Value",
  "summary": "Records that an active guest interaction has produced value worth preserving.",
  "version": 1,
  "maturity": "proposed",
  "requiredInputs": [{ "key": "value-reference", "valueType": "reference", "required": true, "description": "Reference to the conversation, artifact, or work product that produced value." }],
  "guards": [
    { "expression": "guest-identity == active", "failureCode": "guest-not-active" },
    { "expression": "claimable-value == none", "failureCode": "value-already-detected" }
  ],
  "permittedMutations": ["auth.dimension.claimable-value"],
  "requiredEffects": ["associate-value-reference-with-guest-session"],
  "forbiddenEffects": ["create-durable-user", "claim-value"],
  "invariantKeys": ["auth.invariant.guest.may-create-value", "auth.invariant.transition.one-state-changing-action", "auth.invariant.transition.deterministic-post-state"],
  "sourceReferences": [{ "sourceType": "discussion", "reference": "AUTH-MODEL-GUIDE.md", "section": "4.4" }]
}