{
  "$schema": "../schemas/action.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.action.password.assert-email",
  "name": "Assert Password Registration Email",
  "summary": "Associates a user-supplied email address with an active password PendingIdentity without treating it as verified ownership.",
  "version": 1,
  "maturity": "proposed",
  "requiredInputs": [{ "key": "email", "valueType": "string", "required": true, "description": "Normalized email address asserted by the registrant." }],
  "guards": [{ "expression": "pending-identity-status == pending and pending-identity-flow == password", "failureCode": "password-pending-identity-required" }],
  "permittedMutations": ["auth.dimension.email-ownership", "auth.dimension.pending-identity-status"],
  "requiredEffects": ["persist-asserted-email", "issue-email-verification-challenge", "record-password-email-asserted"],
  "forbiddenEffects": ["mark-email-verified", "create-durable-user", "grant-normal-application-authorization"],
  "invariantKeys": ["auth.invariant.pending-identity.no-normal-authorization", "auth.invariant.pending-identity.exactly-one-flow", "auth.invariant.email-identities.not-conflated"],
  "sourceReferences": [{ "sourceType": "discussion", "reference": "AUTH-MODEL-GUIDE.md", "section": "4.6" }]
}