{
  "$schema": "../schemas/action.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.action.password.complete-profile",
  "name": "Complete Password Registration Profile",
  "summary": "Validates and stores the profile fields required before a durable user may be created.",
  "version": 1,
  "maturity": "proposed",
  "requiredInputs": [{ "key": "profile", "valueType": "object", "required": true, "description": "Required normalized registration profile values." }],
  "guards": [{ "expression": "pending-identity-flow == password and pending-identity-status in [pending,resolution-required] and email-ownership == verified", "failureCode": "verified-password-identity-required" }],
  "permittedMutations": ["auth.dimension.profile-completeness"],
  "requiredEffects": ["validate-registration-profile", "persist-registration-profile"],
  "forbiddenEffects": ["create-durable-user", "establish-password", "grant-normal-application-authorization"],
  "invariantKeys": ["auth.invariant.pending-identity.no-normal-authorization", "auth.invariant.pending-identity.exactly-one-flow"],
  "sourceReferences": [{ "sourceType": "discussion", "reference": "AUTH-MODEL-GUIDE.md", "section": "4.6" }]
}