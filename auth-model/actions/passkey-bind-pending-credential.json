{
  "$schema": "../schemas/action.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.action.passkey.bind-pending-credential",
  "name": "Bind Pending Passkey Credential",
  "summary": "Binds verified pending passkey credential material to the explicitly resolved durable identity.",
  "version": 1,
  "maturity": "proposed",
  "requiredInputs": [{ "key": "durable-user-id", "valueType": "reference", "required": true, "description": "Resolved durable identity selected for the credential." }],
  "guards": [{ "expression": "credential-proof == passkey-proved and durable-identity == resolved", "failureCode": "passkey-proof-and-durable-identity-required" }],
  "permittedMutations": [],
  "requiredEffects": ["atomically-bind-passkey-credential-to-durable-user", "clear-pending-passkey-material"],
  "forbiddenEffects": ["create-second-durable-user", "bind-credential-to-different-user", "retain-duplicate-pending-credential"],
  "invariantKeys": ["auth.invariant.identity-resolution.no-duplicate-user", "auth.invariant.transition.one-state-changing-action", "auth.invariant.transition.deterministic-post-state"],
  "sourceReferences": [{ "sourceType": "discussion", "reference": "AUTH-MODEL-GUIDE.md", "section": "4.8" }]
}