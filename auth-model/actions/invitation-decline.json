{
  "$schema": "../schemas/action.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.action.invitation.decline",
  "name": "Decline Invitation",
  "summary": "Declines a valid invitation without changing identity, workspace, or membership state.",
  "version": 1,
  "maturity": "proposed",
  "requiredInputs": [{ "key": "invitation-reference", "valueType": "reference", "required": true, "description": "Validated invitation being declined." }],
  "guards": [{ "expression": "invitation-status in [valid,acceptance-pending]", "failureCode": "invitation-not-declinable" }],
  "permittedMutations": ["auth.dimension.invitation-status"],
  "requiredEffects": ["record-invitation-declined"],
  "forbiddenEffects": ["create-membership", "change-home-workspace", "switch-current-workspace", "resolve-durable-identity"],
  "invariantKeys": ["auth.invariant.invitation.not-identity-proof", "auth.invariant.invitation.accept-does-not-change-home"],
  "sourceReferences": [{ "sourceType": "discussion", "reference": "AUTH-MODEL-GUIDE.md", "section": "4.10" }]
}