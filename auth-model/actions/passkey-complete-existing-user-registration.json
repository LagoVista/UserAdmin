{
  "$schema": "../schemas/action.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.action.passkey.complete-existing-user-registration",
  "name": "Complete Existing User Passkey Registration",
  "summary": "Consumes a user-bound registration challenge, validates attestation, and persists the credential for the same durable user.",
  "version": 1,
  "maturity": "proposed",
  "requiredInputs": [{ "key": "challenge-id", "valueType": "reference", "required": true, "description": "Single-use user-bound registration challenge." }, { "key": "attestation", "valueType": "object", "required": true, "description": "WebAuthn attestation from the secure component." }],
  "guards": [{ "expression": "challenge user, options user, and current durable identity all match", "failureCode": "passkey-registration-user-mismatch" }],
  "permittedMutations": ["auth.dimension.credential-proof"],
  "requiredEffects": ["consume-passkey-challenge", "validate-attestation", "persist-passkey-credential-for-current-user"],
  "forbiddenEffects": ["create-durable-user", "bind-credential-to-different-user", "change-session-identity"],
  "invariantKeys": ["auth.invariant.identity-resolution.no-duplicate-user", "auth.invariant.transition.one-state-changing-action", "auth.invariant.transition.deterministic-post-state"],
  "sourceReferences": [{ "sourceType": "code", "reference": "src/LagoVista.AspNetCore.Identity/Managers/AppUserPasskeyManager.cs", "note": "CompleteRegistrationAsync validates challenge user and options user before persistence" }, { "sourceType": "discussion", "reference": "AUTH-MODEL-GUIDE.md", "section": "4.8" }]
}