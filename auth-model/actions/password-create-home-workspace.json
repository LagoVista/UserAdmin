{
  "$schema": "../schemas/action.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.action.password.create-home-workspace",
  "name": "Create Password Registration Home Workspace",
  "summary": "Creates the durable user's required home workspace and owner membership after durable-user creation.",
  "version": 1,
  "maturity": "proposed",
  "requiredInputs": [{ "key": "durable-identity-reference", "valueType": "reference", "required": true, "description": "Resolved durable identity receiving its home workspace." }],
  "guards": [{ "expression": "durable-identity == resolved and home-workspace == required and workspace-membership == none", "failureCode": "home-workspace-not-required" }],
  "permittedMutations": ["auth.dimension.home-workspace", "auth.dimension.workspace-membership", "auth.dimension.current-workspace"],
  "requiredEffects": ["create-home-workspace-once", "create-home-owner-membership", "select-home-workspace", "record-home-workspace-created"],
  "forbiddenEffects": ["create-second-home-workspace", "consume-workspace-invitation", "grant-normal-application-authorization"],
  "invariantKeys": ["auth.invariant.home-workspace.exactly-one", "auth.invariant.home-workspace.owner-member", "auth.invariant.registration.completes-in-home-workspace"],
  "sourceReferences": [{ "sourceType": "discussion", "reference": "AUTH-MODEL-GUIDE.md", "section": "4.6" }]
}