{
  "$schema": "../schemas/action.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.action.home-workspace.begin-creation",
  "name": "Begin Home Workspace Creation",
  "summary": "Begins idempotent creation of the resolved durable user's required home workspace.",
  "version": 1,
  "maturity": "proposed",
  "requiredInputs": [{ "key": "durable-identity-reference", "valueType": "reference", "required": true, "description": "Resolved durable identity requiring a home workspace." }],
  "guards": [{ "expression": "durable-identity == resolved and home-workspace == required", "failureCode": "home-workspace-not-required" }],
  "permittedMutations": ["auth.dimension.home-workspace"],
  "requiredEffects": ["acquire-idempotent-home-workspace-operation", "record-home-workspace-creation-started"],
  "forbiddenEffects": ["create-second-home-workspace", "create-membership-before-workspace", "grant-normal-application-authorization"],
  "invariantKeys": ["auth.invariant.home-workspace.exactly-one", "auth.invariant.transition.one-state-changing-action", "auth.invariant.transition.deterministic-post-state"],
  "sourceReferences": [{ "sourceType": "discussion", "reference": "AUTH-MODEL-GUIDE.md", "section": "4.9" }]
}