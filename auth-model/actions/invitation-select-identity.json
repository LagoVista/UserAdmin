{
  "$schema": "../schemas/action.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.action.invitation.select-identity",
  "name": "Select Invitation Identity",
  "summary": "Explicitly selects the resolved durable identity that will accept a valid invitation.",
  "version": 1,
  "maturity": "proposed",
  "requiredInputs": [{ "key": "durable-identity-reference", "valueType": "reference", "required": true, "description": "Explicitly selected durable identity." }],
  "guards": [{ "expression": "invitation-status == valid and durable-identity == resolved", "failureCode": "durable-identity-not-resolved" }],
  "permittedMutations": ["auth.dimension.invitation-status", "auth.dimension.presentation-context"],
  "requiredEffects": ["bind-selected-durable-identity", "present-acceptance-summary", "record-identity-selection"],
  "forbiddenEffects": ["accept-invitation", "create-membership", "change-home-workspace", "switch-current-workspace"],
  "invariantKeys": ["auth.invariant.invitation.requires-selected-identity", "auth.invariant.email-identities.not-conflated"],
  "sourceReferences": [{ "sourceType": "discussion", "reference": "AUTH-MODEL-GUIDE.md", "section": "4.10" }]
}