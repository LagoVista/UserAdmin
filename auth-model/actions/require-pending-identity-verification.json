{
  "$schema": "../schemas/action.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.action.pending-identity.require-verification",
  "name": "Require Pending Identity Verification",
  "summary": "Moves an active pending identity into a state requiring additional proof.",
  "version": 1,
  "maturity": "proposed",
  "requiredInputs": [{ "key": "verification-reason", "valueType": "string", "required": true }],
  "guards": [{ "expression": "pending-identity-status == pending", "failureCode": "pending-identity-not-awaiting-decision" }],
  "permittedMutations": ["auth.dimension.pending-identity-status", "auth.dimension.session-capability"],
  "requiredEffects": ["record-verification-requirement"],
  "forbiddenEffects": ["resolve-durable-identity", "grant-normal-application-authorization"],
  "invariantKeys": ["auth.invariant.pending-identity.no-normal-authorization", "auth.invariant.pending-identity.exactly-one-flow"],
  "sourceReferences": [{ "sourceType": "discussion", "reference": "AUTH-MODEL-GUIDE.md", "section": "4.5" }]
}