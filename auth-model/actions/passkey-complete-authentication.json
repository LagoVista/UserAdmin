{
  "$schema": "../schemas/action.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.action.passkey.complete-authentication",
  "name": "Complete Passkey Authentication",
  "summary": "Consumes a passkey assertion challenge, validates the credential and counter, and resolves the existing durable identity.",
  "version": 1,
  "maturity": "proposed",
  "requiredInputs": [{ "key": "challenge-id", "valueType": "reference", "required": true, "description": "Single-use authentication challenge." }, { "key": "assertion", "valueType": "object", "required": true, "description": "WebAuthn assertion returned by the secure component." }],
  "guards": [{ "expression": "challenge is unexpired, unconsumed, origin-bound, rp-bound, and credential maps to one enabled durable user", "failureCode": "invalid-passkey-assertion" }],
  "permittedMutations": ["auth.dimension.credential-proof", "auth.dimension.durable-identity", "auth.dimension.session-capability"],
  "requiredEffects": ["consume-passkey-challenge", "validate-passkey-assertion", "advance-sign-counter", "resolve-existing-durable-user"],
  "forbiddenEffects": ["create-durable-user", "resolve-different-user", "grant-step-up-without-required-user-verification"],
  "invariantKeys": ["auth.invariant.identity-resolution.no-duplicate-user", "auth.invariant.disabled-user.no-normal-session", "auth.invariant.transition.one-state-changing-action", "auth.invariant.transition.deterministic-post-state"],
  "sourceReferences": [{ "sourceType": "code", "reference": "src/LagoVista.AspNetCore.Identity/Managers/AppUserPasskeyManager.cs", "note": "CompleteAuthenticationAsync assertion, credential-owner, and sign-counter validation" }, { "sourceType": "discussion", "reference": "AUTH-MODEL-GUIDE.md", "section": "4.8" }]
}