{
  "$schema": "../schemas/action.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.action.pending-identity.fail",
  "name": "Fail Pending Identity",
  "summary": "Terminates the identity ceremony after a non-recoverable validation, security, or provider failure.",
  "version": 1,
  "maturity": "proposed",
  "requiredInputs": [{ "key": "failure-code", "valueType": "string", "required": true }],
  "guards": [{ "expression": "pending-identity-status in [pending,verification-required,verifying,resolution-required]", "failureCode": "pending-identity-not-active" }],
  "permittedMutations": ["auth.dimension.pending-identity-status", "auth.dimension.pending-identity-flow", "auth.dimension.session-capability"],
  "requiredEffects": ["invalidate-pending-identity-secrets", "record-pending-identity-failed"],
  "forbiddenEffects": ["resolve-durable-identity", "grant-normal-application-authorization", "silently-retry-terminal-failure"],
  "invariantKeys": ["auth.invariant.pending-identity.no-normal-authorization", "auth.invariant.transition.deterministic-post-state"],
  "sourceReferences": [{ "sourceType": "discussion", "reference": "AUTH-MODEL-GUIDE.md", "section": "4.5" }]
}