{
  "$schema": "../schemas/action.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.action.recovery.establish-replacement-credential",
  "name": "Establish Replacement Credential",
  "summary": "Establishes a replacement credential for the recovered existing durable identity while the session remains recovery-limited.",
  "version": 1,
  "maturity": "proposed",
  "requiredInputs": [
    { "key": "recovery-reference", "valueType": "reference", "required": true, "description": "Proved recovery ceremony reference." },
    { "key": "replacement-credential-reference", "valueType": "reference", "required": true, "description": "Opaque password, passkey, MFA, or equivalent credential result from a secure component." }
  ],
  "guards": [
    { "expression": "recovery-state in [proved,credential-reset-required]", "failureCode": "recovery-not-proved" },
    { "expression": "durable-identity == resolved", "failureCode": "recovery-identity-not-resolved" },
    { "expression": "replacement credential satisfies current policy", "failureCode": "replacement-credential-policy-failed" }
  ],
  "permittedMutations": ["auth.dimension.recovery-state", "auth.dimension.credential-proof", "auth.dimension.mfa-state", "auth.dimension.session-capability"],
  "requiredEffects": ["persist-replacement-credential-atomically", "invalidate-superseded-recovery-material", "record-replacement-credential-established"],
  "forbiddenEffects": ["create-durable-user", "grant-normal-application-authorization", "change-home-workspace", "accept-invitation"],
  "invariantKeys": ["auth.invariant.recovery.existing-identity-only", "auth.invariant.transition.deterministic-post-state"],
  "sourceReferences": [{ "sourceType": "discussion", "reference": "AUTH-MODEL-GUIDE.md", "section": "4.14" }]
}