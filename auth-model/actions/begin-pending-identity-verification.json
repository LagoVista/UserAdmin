{
  "$schema": "../schemas/action.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.action.pending-identity.begin-verification",
  "name": "Begin Pending Identity Verification",
  "summary": "Starts verification for a pending identity that requires additional proof.",
  "version": 1,
  "maturity": "proposed",
  "requiredInputs": [{ "key": "verification-reference", "valueType": "reference", "required": true }],
  "guards": [{ "expression": "pending-identity-status == verification-required", "failureCode": "verification-not-required" }],
  "permittedMutations": ["auth.dimension.pending-identity-status"],
  "requiredEffects": ["start-verification-operation", "record-verification-started"],
  "forbiddenEffects": ["resolve-durable-identity", "grant-normal-application-authorization"],
  "invariantKeys": ["auth.invariant.pending-identity.no-normal-authorization", "auth.invariant.pending-identity.exactly-one-flow"],
  "sourceReferences": [{ "sourceType": "discussion", "reference": "AUTH-MODEL-GUIDE.md", "section": "4.5" }]
}