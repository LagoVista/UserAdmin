{
  "$schema": "../schemas/auth-view.schema.json",
  "schemaVersion": "1.0",
  "viewId": "auth.password.reset.complete",
  "name": "Choose a New Password",
  "description": "Allows an anonymous user whose six-digit recovery code was successfully verified to choose and confirm a new password using reset authority held internally by the application flow.",
  "category": "recovery",
  "routeId": "auth.route.password.reset.complete",
  "status": "active",
  "controls": [
    {
      "id": "new-password",
      "name": "New Password",
      "controlType": "password-input",
      "finder": "field:new-password",
      "required": true,
      "sensitivity": "credential"
    },
    {
      "id": "confirm-password",
      "name": "Confirm Password",
      "controlType": "password-input",
      "finder": "field:confirm-password",
      "required": true,
      "sensitivity": "credential"
    },
    {
      "id": "validation-error",
      "name": "Validation Error",
      "controlType": "status",
      "finder": "status:validation-error",
      "sensitivity": "public"
    }
  ],
  "actions": [
    {
      "id": "reset-password",
      "name": "Reset Password",
      "actionType": "button",
      "finder": "action:reset-password"
    },
    {
      "id": "cancel",
      "name": "Cancel",
      "actionType": "button",
      "finder": "action:cancel"
    }
  ],
  "platforms": {
    "web": {
      "status": "implemented",
      "repository": "softwarelogistics/nuviot-ui-shared",
      "path": "user/reset-password/reset-password.component.ts",
      "component": "ResetPasswordComponent",
      "implementation": "ResetPasswordComponent",
      "conformance": {
        "status": "verified",
        "checkedAgainst": ["view-identity", "controls", "actions", "finders", "navigation"],
        "notes": "The Angular form exposes the canonical new-password and confirmation controls, consumes reset authority held in session state, calls the generated Auth reset operation, remains on the view when completion is rejected, and returns to password sign-in on success."
      }
    },
    "mobile": {
      "status": "implemented",
      "repository": "nuviot/vtm-client",
      "path": "src/features/authentication/nuviot-account/screens/password-recovery-reset-screen.tsx",
      "component": "PasswordRecoveryResetScreen",
      "implementation": "PasswordRecoveryResetScreen",
      "conformance": {
        "status": "verified",
        "checkedAgainst": ["view-identity", "controls", "actions", "finders", "navigation"],
        "notes": "The React Native form exposes the canonical new-password and confirmation controls, consumes reset authority held in AuthFlowContext, calls the generated Auth reset operation, remains on the view when completion is rejected, and returns to password sign-in on success."
      }
    }
  },
  "source": {
    "runtimeEntityId": "BB23CECB524D4103AFF320DCC5FF1590",
    "runtimeSha256Hex": "693e1151f6dc007e04feeda2a4b1c815115d066fe4658590376f56b8286b4dde",
    "webComponent": "ResetPasswordComponent",
    "mobileComponent": "PasswordRecoveryResetScreen"
  }
}
