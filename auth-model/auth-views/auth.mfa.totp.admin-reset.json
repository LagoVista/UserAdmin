    { "id": "reset-warning", "name": "Reset Warning", "controlType": "status", "finder": "status:reset-warning", "sensitivity": "public" }
  ],
  "actions": [
    { "id": "reset-totp", "name": "Reset TOTP", "actionType": "button", "finder": "action:reset-totp" },
    { "id": "cancel", "name": "Cancel", "actionType": "button", "finder": "action:cancel" }
  ],
  "platforms": {
