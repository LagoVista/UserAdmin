{
  "$schema": "../schemas/auth-view.schema.json",
  "schemaVersion": "1.0",
  "viewId": "auth.mfa.totp.rotate-recovery-codes",
  "name": "Rotate TOTP Recovery Codes",
  "description": "Warns that rotating recovery codes invalidates the current set and requires an explicit confirmation before the server mutation occurs.",
  "category": "totp",
  "routeId": "auth.route.mfa.totp.rotate-recovery-codes",
  "status": "active",
  "controls": [
    {
      "id": "rotation-warning",
      "name": "Rotation Warning",
      "controlType": "label",
      "finder": "label:rotation-warning",
      "sensitivity": "public"
    },
    {
      "id": "rotation-error",
      "name": "Rotation Error",
      "controlType": "status",
      "finder": "status:rotation-error",
      "sensitivity": "public",
      "visibilityCondition": "Recovery-code rotation failed."
    }
  ],
  "actions": [
    {
      "id": "rotate",
      "name": "Rotate Codes",
      "actionType": "button",
      "finder": "action:rotate"
    },
    {
      "id": "back",
      "name": "Back",
      "actionType": "button",
      "finder": "action:back"
    },
    {
      "id": "cancel",
      "name": "Cancel",
      "actionType": "button",
      "finder": "action:cancel"
    }
  ],
  "platforms": {
    "web": { "status": "planned" },
    "mobile": { "status": "planned" }
  }
}
