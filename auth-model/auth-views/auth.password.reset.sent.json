{
  "$schema": "../schemas/auth-view.schema.json",
  "schemaVersion": "1.0",
  "viewId": "auth.password.reset.sent",
  "name": "Enter Password Recovery Code",
  "description": "Presents the neutral recovery-code state after a password recovery request and allows the user to submit the six-digit code without revealing whether the requested account exists.",
  "category": "recovery",
  "routeId": "auth.route.password.reset.sent",
  "status": "active",
  "controls": [
    { "id": "recovery-code", "name": "Recovery Code", "controlType": "code-input", "finder": "field:recovery-code", "required": true, "sensitivity": "secret" },
    { "id": "validation-error", "name": "Validation Error", "controlType": "status", "finder": "status:validation-error", "sensitivity": "public" }
  ],
  "actions": [
    { "id": "verify-recovery-code", "name": "Verify Recovery Code", "actionType": "button", "finder": "action:verify-recovery-code" },
    { "id": "resend-code", "name": "Resend Code", "actionType": "button", "finder": "action:resend-code" },
    { "id": "back-to-sign-in", "name": "Back to Sign In", "actionType": "link", "finder": "action:back-to-sign-in" },
    { "id": "cancel", "name": "Cancel", "actionType": "link", "finder": "action:cancel" }
  ],
  "platforms": {
    "web": {
      "status": "implemented",
      "repository": "softwarelogistics/nuviot-ui-shared",
      "path": "user/forgot-password-sent/forgot-password-sent.component.ts",
      "component": "ForgotPasswordSentComponent",
      "implementation": "ForgotPasswordSentComponent",
      "conformance": {
        "status": "verified",
        "checkedAgainst": ["view-identity", "controls", "actions", "finders", "navigation"],
        "notes": "The Angular surface accepts a six-digit recovery code, verifies it through the generated Auth client, stores returned reset authority in session state rather than the URL, supports resend, and exposes the canonical semantic finders and navigation actions."
      }
    },
    "mobile": {
      "status": "implemented",
      "repository": "nuviot/vtm-client",
      "path": "src/features/authentication/nuviot-account/screens/password-recovery-code-screen.tsx",
      "component": "PasswordRecoveryCodeScreen",
      "implementation": "PasswordRecoveryCodeScreen",
      "conformance": {
        "status": "verified",
        "checkedAgainst": ["view-identity", "controls", "actions", "finders", "navigation"],
        "notes": "The React Native surface accepts and validates a six-digit recovery code, verifies it through the generated Auth client, stores returned reset authority in AuthFlowContext, supports resend, and exposes the canonical semantic finders and navigation actions."
      }
    }
  },
