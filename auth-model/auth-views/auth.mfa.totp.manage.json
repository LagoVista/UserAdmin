{
  "$schema": "../schemas/auth-view.schema.json",
  "schemaVersion": "1.0",
  "viewId": "auth.mfa.totp.manage",
  "name": "Manage TOTP",
  "description": "Lets an authenticated user with TOTP enabled choose a maintenance operation without mutating MFA state on the landing surface.",
  "category": "totp",
  "routeId": "auth.route.mfa.totp.manage",
  "status": "active",
  "controls": [
    {
      "id": "totp-enabled",
      "name": "TOTP Enabled",
      "controlType": "status",
      "finder": "status:totp-enabled",
      "sensitivity": "public"
    }
  ],
  "actions": [
    {
      "id": "rotate-recovery-codes",
      "name": "Rotate Recovery Codes",
      "actionType": "button",
      "finder": "action:rotate-recovery-codes"
    },
    {
      "id": "disable",
      "name": "Disable TOTP",
      "actionType": "button",
      "finder": "action:disable"
    },
    {
      "id": "done",
      "name": "Done",
      "actionType": "button",
      "finder": "action:done"
    }
  ],
  "platforms": {
    "web": { "status": "planned" },
    "mobile": { "status": "planned" }
  },
  "notes": [
    "This is a client-only branching surface. Destructive server operations occur only after an explicit confirmation view."
  ]
}
