{
  "$schema": "../schemas/presentation-binding.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.presentation.web.password-registration",
  "name": "Web Password Registration",
  "summary": "Binds the traditional web registration form to the canonical password-registration model while recording that the current createRegister endpoint performs multiple logical actions behind one submit operation.",
  "version": 1,
  "maturity": "proposed",
  "channel": "traditional-form",
  "platform": "web",
  "scenarioKeys": [
    "auth.scenario.password.begin-registration",
    "auth.scenario.password.assert-email",
    "auth.scenario.password.complete-profile",
    "auth.scenario.password.establish-credential",
    "auth.scenario.password.create-durable-user"
  ],
  "actionKey": "auth.action.pending-identity.begin",
  "authViewKey": "auth.register.new",
  "route": "/auth/register",
  "viewId": "auth.register.new",
  "fieldBindings": [
    { "inputKey": "first-name", "authViewFieldId": null, "finder": "formControlName:firstName", "bindingType": "field", "valueSource": "user input" },
    { "inputKey": "last-name", "authViewFieldId": null, "finder": "formControlName:lastName", "bindingType": "field", "valueSource": "user input" },
    { "inputKey": "email", "authViewFieldId": null, "finder": "field:email", "bindingType": "field", "valueSource": "user input" },
    { "inputKey": "password", "authViewFieldId": null, "finder": "field:password", "bindingType": "field", "valueSource": "secure user input" },
    { "inputKey": "confirm-password", "authViewFieldId": null, "finder": "field:confirmPassword", "bindingType": "field", "valueSource": "secure user input" }
  ],
  "actionBinding": {
    "authFieldActionId": null,
    "finder": "action:register",
    "bindingType": "submit",
    "operationReference": "ServiceContext.clients.user.createRegister"
  },
  "expectedViewId": "auth.user.email.confirm.sent",
  "expectedRoute": "/auth/user/email/confirm/sent",
  "sourceReferences": [
    { "sourceType": "code", "reference": "softwarelogistics/nuviot-ui-shared/auth-routes.ts", "note": "Traditional web registration route." },
    { "sourceType": "code", "reference": "softwarelogistics/nuviot-ui-shared/user/register-user-new/register-user-new.component.html", "note": "View ID, fields, and semantic action finders." },
    { "sourceType": "code", "reference": "softwarelogistics/nuviot-ui-shared/user/register-user-new/register-user-new.component.ts", "note": "Current composite createRegister operation and success navigation." },
    { "sourceType": "discussion", "reference": "AUTH-MODEL-GUIDE.md", "section": "4.12" }
  ]
}