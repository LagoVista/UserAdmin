{
  "$schema": "../../schemas/auth-test-binding.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.test-binding.passkey-sign-in",
  "name": "Passkey Sign-In Service Proof",
  "summary": "Registers service-level proof that email-bound Passkey Sign In resolves one durable account, requires user verification for challenge issuance, binds completion to that same user, and does not expose or authenticate on failed proof.",
  "version": 2,
  "maturity": "implemented",
  "testLevel": "handler-integration",
  "repository": "LagoVista/UserAdmin",
  "projectPath": "tests/LagoVista.UserAdmin.Auth.Tests",
  "sourcePath": "tests/LagoVista.UserAdmin.Auth.Tests/EmailPasskeyAuthenticationServiceTests.cs",
  "framework": "NUnit",
  "testTypeName": "EmailPasskeyAuthenticationServiceTests",
  "testMethodNames": [
    "Begin_WithKnownEmail_Should_ResolveExactUser_AndRequireUserVerification",
    "Begin_WithUnknownEmail_Should_NotAskPasskeyManagerForChallenge",
    "Begin_WhenUserBoundChallengeFails_Should_ReturnNeutralFailure",
    "Complete_WithValidProof_Should_BindProofToResolvedUser_AndReturnThatUser",
    "Complete_ForMfa_Should_ForwardStepUpToSameUserBoundProof",
    "Complete_WithUnknownEmail_Should_NotEvaluateAssertion",
    "Complete_WhenAssertionFails_Should_NotReturnResolvedUser",
    "Complete_WithMissingRequest_Should_RejectBeforeResolvingUser"
  ],
  "scenarioKeys": ["auth.scenario.passkey.passkey-to-home"],
  "handlerKeys": [],
  "endpointBindingKeys": [],
  "transitionKeys": ["auth.transition.passkey.complete-authentication"],
  "proofObligations": [
    "email-is-normalized-before-durable-user-resolution",
    "known-email-resolves-exact-durable-user",
    "primary-passkey-challenge-requires-user-verification",
    "unknown-email-does-not-request-passkey-challenge",
    "passkey-challenge-failure-is-returned-as-neutral-public-failure",
    "assertion-completion-is-bound-to-the-email-resolved-user-id",
    "mfa-step-up-flag-is-forwarded-to-the-same-user-bound-proof-primitive",
    "unknown-email-does-not-evaluate-passkey-assertion",
    "failed-passkey-proof-does-not-return-a-durable-user",
    "missing-completion-request-is-rejected-before-user-resolution",
    "canonical-passkey-complete-authentication-transition"
  ],
  "notes": [
    "This binding proves the email-resolution and service orchestration boundary. The deeper real-manager WebAuthn obligations are bound separately by auth.test-binding.passkey-sign-in.real-manager.",
    "Browser and mobile proven-user session adapters are bound separately by auth.test-binding.passkey-sign-in.session-completion.",
    "Runtime execution evidence remains separate from authored proof status."
  ],
  "sourceReferences": [
    { "sourceType": "test", "reference": "LagoVista/UserAdmin:tests/LagoVista.UserAdmin.Auth.Tests/EmailPasskeyAuthenticationServiceTests.cs", "note": "Email resolution, UV-required begin, exact-user completion and negative-path proof source." },
    { "sourceType": "code", "reference": "LagoVista/UserAdmin:src/LagoVista.AspNetCore.Identity/Services/EmailPasskeyAuthenticationService.cs", "note": "Service under proof resolves the expected account and delegates to the shared user-bound passkey manager." },
    { "sourceType": "test", "reference": "auth.test-binding.passkey-sign-in.real-manager", "note": "Companion binding covers the real AppUserPasskeyManager security invariants." },
    { "sourceType": "test", "reference": "auth.test-binding.passkey-sign-in.session-completion", "note": "Companion binding covers browser-session and mobile-token completion after accepted proof." }
  ]
}
