{
  "$schema": "../../schemas/auth-test-binding.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.test-binding.passkey-sign-in",
  "name": "Passkey Sign-In Server Proof",
  "summary": "Registers source-level server proof that email-bound Passkey Sign In resolves one durable account, requires user verification for challenge issuance, binds completion to that same user, and does not expose or authenticate on failed proof.",
  "version": 1,
  "maturity": "implemented",
  "testLevel": "handler-integration",
  "repository": "LagoVista/UserAdmin",
  "projectPath": "tests/LagoVista.UserAdmin.Auth.Tests",
  "sourcePath": "tests/LagoVista.UserAdmin.Auth.Tests/EmailPasskeyAuthenticationServiceTests.cs",
  "framework": "NUnit",
  "testTypeName": "EmailPasskeyAuthenticationServiceTests",
  "testMethodNames": [
    "Begin_WithKnownEmail_Should_ResolveExactUser_AndRequireUserVerification",
    "Begin_WithUnknownEmail_Should_NotAskPasskeyManagerForChallenge",
    "Begin_WhenUserBoundChallengeFails_Should_ReturnNeutralFailure",
    "Complete_WithValidProof_Should_BindProofToResolvedUser_AndReturnThatUser",
    "Complete_ForMfa_Should_ForwardStepUpToSameUserBoundProof",
    "Complete_WithUnknownEmail_Should_NotEvaluateAssertion",
    "Complete_WhenAssertionFails_Should_NotReturnResolvedUser",
    "Complete_WithMissingRequest_Should_RejectBeforeResolvingUser"
  ],
  "scenarioKeys": [
    "auth.scenario.passkey.passkey-to-home"
  ],
  "handlerKeys": [],
  "endpointBindingKeys": [],
  "transitionKeys": [
    "auth.transition.passkey.complete-authentication"
  ],
  "proofObligations": [
    "email-is-normalized-before-durable-user-resolution",
    "known-email-resolves-exact-durable-user",
    "primary-passkey-challenge-requires-user-verification",
    "unknown-email-does-not-request-passkey-challenge",
    "passkey-challenge-failure-is-returned-as-neutral-public-failure",
    "assertion-completion-is-bound-to-the-email-resolved-user-id",
    "mfa-step-up-flag-is-forwarded-to-the-same-user-bound-proof-primitive",
    "unknown-email-does-not-evaluate-passkey-assertion",
    "failed-passkey-proof-does-not-return-a-durable-user",
    "missing-completion-request-is-rejected-before-user-resolution",
    "canonical-passkey-complete-authentication-transition"
  ],
  "notes": [
    "These tests exercise EmailPasskeyAuthenticationService with IAppUserRepo and IAppUserPasskeyManager as infrastructure/security seams. They do not fake a browser or native authenticator ceremony.",
    "The real AppUserPasskeyManager WebAuthn cryptographic proof path, browser session adapter, and mobile token adapter require additional integration/runtime proof slices.",
    "Runtime execution evidence remains separate from this authored proof binding; these tests have not yet been run after authoring."
  ],
  "sourceReferences": [
    {
      "sourceType": "test",
      "reference": "LagoVista/UserAdmin:tests/LagoVista.UserAdmin.Auth.Tests/EmailPasskeyAuthenticationServiceTests.cs",
      "note": "Email resolution, UV-required begin, exact-user completion and negative-path proof source."
    },
    {
      "sourceType": "code",
      "reference": "LagoVista/UserAdmin:src/LagoVista.AspNetCore.Identity/Services/EmailPasskeyAuthenticationService.cs",
      "note": "Service under proof resolves the expected account and delegates to the shared user-bound passkey manager."
    },
    {
      "sourceType": "code",
      "reference": "LagoVista/UserAdmin:src/LagoVista.AspNetCore.Identity/Managers/AppUserPasskeyManager.cs",
      "note": "Shared WebAuthn proof primitive that remains the next deeper integration-test target."
    }
  ]
}
