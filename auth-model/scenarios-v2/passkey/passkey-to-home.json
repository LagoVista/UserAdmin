      "auth.transition.passkey.complete-authentication"
    ]
  },
  "expectedViewKey": "app.home",
  "postconditions": {
    "expression": "credential-proof == passkey-proved and session-capability in [authenticated-limited,authenticated-normal]"
  },
  "expectedAuthLogEvents": [
    "passkey-authentication-challenge-issued",
    "passkey-authentication-succeeded"
  ],
