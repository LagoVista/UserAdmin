  "schemaVersion": "2.0",
  "key": "auth.scenario.passkey.passkey-to-home",
  "name": "Passkey Authentication to Home",
  "summary": "The user completes a valid passkey assertion, the server resolves the existing durable user, and the client opens the application home view.",
  "version": 1,
  "maturity": "proposed",
  "categoryKey": "passkey",
  "startViewKey": "auth.continue.passkey",
  "action": {
    "id": "use-passkey",
    "finder": "action:use-passkey"
  },
  "preconditions": {
    "expression": "session-capability == anonymous and a registered passkey is available"
  },
  "inputs": [],
  "serverInteraction": {
    "required": true,
    "intent": "Issue and validate a passkey authentication challenge, resolve the existing durable user, advance the signature counter, and establish the application session.",
