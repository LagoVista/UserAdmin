{
  "$schema": "../../schemas/app-user-test-scenario-v2.schema.json",
  "schemaVersion": "2.0",
  "key": "auth.scenario.email-verification.retry-success.accept-code",
  "runtimeEntityId": "A162B263C364D465E566F667A768B869",
  "name": "Email Verification Retry Success Accept Code",
  "summary": "After one rejected attempt, the retry-success behavior submits the current valid verification code and completes email verification.",
  "version": 1,
  "maturity": "proposed",
  "categoryKey": "email-verification",
  "startViewKey": "auth.email-verification.enter",
  "startViewState": "code-rejected",
  "action": { "id": "verify-verification-code", "finder": "action:verify-verification-code" },
  "preconditions": {
    "expression": "durable identity is unverified and the current verification challenge remains valid after one failed attempt",
    "state": { "emailConfirmed": "notset", "emailVerificationCode": { "status": "valid", "attemptCount": 1 } }
  },
  "inputs": [{ "finder": "field:verification-code", "name": "Verification Code", "valueType": "secret-reference", "required": true, "value": "user.emailVerificationCode" }],
  "serverInteraction": { "required": true, "intent": "Accept the still-current verification proof, verify email ownership, and consume the proof.", "transitionKeys": ["auth.transition.email-verification.code-accepted"] },
  "expectedViewKey": "auth.email-verification.confirmed",
  "postconditions": {
    "expression": "email ownership is verified and the verification proof is consumed",
    "state": { "emailConfirmed": "set", "emailVerificationCode": { "status": "consumed" } }
  },
  "expectedAuthLogEvents": ["ConfirmEmailSuccess"],
  "evidenceRequirements": ["server", "web", "android", "ios"],
  "sourceReferences": [{ "sourceType": "auth-view", "reference": "auth.email-verification.confirmed" }],
  "progress": { "presentation": "complete", "implementation": "complete", "tests": "complete" }
}
