  "runtimeEntityId": "7D4B1C90A2E34F6A8B1C2D3E4F5A6071",
  "name": "Send Verification Code to Entry",
  "summary": "An unverified durable user requests email verification, a fresh six-digit code is issued, and the client advances to code entry in the ready presentation state.",
  "version": 1,
  "maturity": "proposed",
  "categoryKey": "email-verification",
  "startViewKey": "auth.email-verification.send",
  "action": {
    "id": "send-verification-code",
    "finder": "action:send-verification-code"
  },
  "preconditions": {
    "expression": "durable identity exists with an email address and email is not confirmed",
    "state": {
      "ensureUserExists": "set",
      "userHasEmail": "set",
      "emailConfirmed": "notset",
      "emailVerificationCode": { "status": "notset" }
    }
  },
  "inputs": [],
  "serverInteraction": {
    "required": true,
    "intent": "Issue and send a fresh email-verification code without changing email ownership.",
    "transitionKeys": ["auth.transition.email-verification.code-sent"]
  },
  "expectedViewKey": "auth.email-verification.enter",
  "expectedViewState": "ready",
  "expectedVisibleFinders": ["field:verification-code", "action:verify-verification-code", "action:resend-verification-code"],
  "postconditions": {
    "expression": "email remains unconfirmed and a valid email-verification code exists",
    "state": {
      "emailConfirmed": "notset",
      "emailVerificationCode": { "status": "valid", "attemptCount": 0 }
    }
  },
  "expectedAuthLogEvents": [],
  "evidenceRequirements": ["server", "web", "android", "ios"],
