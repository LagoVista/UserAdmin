{
  "$schema": "../schemas/transition.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.transition.email-verification.code-accepted",
  "name": "Email Verification Code Accepted",
  "summary": "Accepts valid current verification proof, verifies email ownership, and consumes the proof.",
  "version": 1,
  "maturity": "proposed",
  "categoryKey": "email-verification",
  "priority": 100,
  "sourceState": { "expression": "durable-identity == resolved and email-confirmed == false" },
  "actionKey": "auth.action.email-verification.verify-code",
  "guards": [{ "expression": "verification-code-valid == true", "failureCode": "email-verification-invalid" }],
  "destinationTransform": [{ "dimensionKey": "auth.dimension.email-ownership", "operation": "set", "valueExpression": "verified" }],
  "requiredEffects": ["confirm-email-once", "consume-email-verification-code", "record-email-verification-result"],
  "forbiddenEffects": ["create-durable-user", "change-home-workspace", "switch-current-workspace"],
  "invariantKeys": ["auth.invariant.transition.deterministic-post-state"],
  "sourceReferences": [{ "sourceType": "code", "reference": "src/LagoVista.UserAdmin/Managers/UserVerficationManager.cs" }]
}
