{
  "$schema": "../schemas/transition.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.transition.passkey.begin-step-up",
  "name": "Begin Passkey Step Up",
  "summary": "Issues a user-verifying assertion challenge for the current authenticated durable identity.",
  "version": 1,
  "maturity": "proposed",
  "priority": 70,
  "sourceState": { "expression": "durable-identity == resolved and session-capability in [authenticated-limited,authenticated-normal] and credential-proof != challenge-issued" },
  "actionKey": "auth.action.passkey.begin-step-up",
  "guards": [],
  "destinationTransform": [
    { "dimensionKey": "auth.dimension.credential-proof", "operation": "set", "valueExpression": "challenge-issued" }
  ],
  "requiredEffects": ["create-short-lived-passkey-step-up-challenge", "require-user-verification"],
  "forbiddenEffects": ["grant-step-up-before-assertion", "change-durable-identity", "create-durable-user"],
  "invariantKeys": ["auth.invariant.transition.one-state-changing-action", "auth.invariant.transition.deterministic-post-state"],
  "sourceReferences": [{ "sourceType": "discussion", "reference": "AUTH-MODEL-GUIDE.md", "section": "4.8" }]
}