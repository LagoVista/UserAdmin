{
  "$schema": "../schemas/transition.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.transition.password.create-home-workspace",
  "name": "Create Password Registration Home Workspace",
  "summary": "Creates and selects the resolved user's required home workspace with owner membership.",
  "version": 1,
  "maturity": "proposed",
  "priority": 40,
  "sourceState": { "expression": "durable-identity == resolved and account-status == active and home-workspace == required and workspace-membership == none and current-workspace == none" },
  "actionKey": "auth.action.password.create-home-workspace",
  "guards": [{ "expression": "input.durable-identity-reference matches the resolved durable identity", "failureCode": "durable-identity-reference-mismatch" }],
  "destinationTransform": [
    { "dimensionKey": "auth.dimension.home-workspace", "operation": "set", "valueExpression": "established" },
    { "dimensionKey": "auth.dimension.workspace-membership", "operation": "set", "valueExpression": "home-only" },
    { "dimensionKey": "auth.dimension.current-workspace", "operation": "set", "valueExpression": "home" }
  ],
  "requiredEffects": ["create-home-workspace-once", "create-home-owner-membership", "select-home-workspace", "record-home-workspace-created"],
  "forbiddenEffects": ["create-second-home-workspace", "consume-workspace-invitation", "grant-normal-application-authorization"],
  "invariantKeys": ["auth.invariant.home-workspace.exactly-one", "auth.invariant.home-workspace.owner-member", "auth.invariant.registration.completes-in-home-workspace", "auth.invariant.current-workspace.requires-access", "auth.invariant.transition.one-state-changing-action", "auth.invariant.transition.deterministic-post-state"],
  "sourceReferences": [{ "sourceType": "discussion", "reference": "AUTH-MODEL-GUIDE.md", "section": "4.6" }]
}