{
  "$schema": "../schemas/transition.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.transition.guest.mark-value-claimable",
  "name": "Mark Guest Value Claimable",
  "summary": "Promotes detected guest-created value into a stable claimable state.",
  "version": 1,
  "maturity": "proposed",
  "priority": 80,
  "sourceState": { "expression": "guest-identity == active and claimable-value == detected and durable-identity == absent" },
