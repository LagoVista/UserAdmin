  "requiredEffects": ["persist-claimable-value-binding"],
  "forbiddenEffects": ["create-durable-user", "claim-value"],
  "invariantKeys": ["auth.invariant.guest.may-create-value", "auth.invariant.transition.one-state-changing-action", "auth.invariant.transition.deterministic-post-state"],
