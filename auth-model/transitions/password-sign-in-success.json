{
  "$schema": "../schemas/transition.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.transition.password-sign-in.success",
  "name": "Password Sign-In Success",
  "summary": "Records successful password authentication and establishes a normal authenticated session for the existing durable identity.",
  "version": 1,
  "maturity": "implemented",
  "categoryKey": "password-sign-in",
  "priority": 100,
  "sourceState": { "expression": "session-capability == anonymous" },
  "actionKey": "auth.action.password-sign-in.submit",
  "guards": [
    { "expression": "submitted password credentials are accepted and the account can complete application sign-in", "failureCode": "password-sign-in-not-successful" }
  ],
  "destinationTransform": [
    { "dimensionKey": "auth.dimension.session-capability", "operation": "derive", "valueExpression": "authenticated-normal" },
    { "dimensionKey": "auth.dimension.credential-proof", "operation": "set", "valueExpression": "password-proved" }
  ],
  "requiredEffects": ["issue-authenticated-session", "record-password-authentication-success", "resolve-application-landing-destination"],
  "forbiddenEffects": ["create-durable-user", "change-password-credential", "disclose-account-existence-on-failure"],
  "invariantKeys": ["auth.invariant.transition.one-state-changing-action", "auth.invariant.transition.deterministic-post-state"],
  "sourceReferences": [
    { "sourceType": "code", "reference": "src/LagoVista.UserAdmin/Authentication/Flows/PasswordLoginFlowHandler.cs", "note": "Emits this transition when the sign-in manager returns a successful result." },
    { "sourceType": "code", "reference": "src/LagoVista.AspNetCore.Identity/Managers/SigninManager.cs", "note": "Successful password authentication completes the application sign-in, records PasswordAuthenticationSucceeded, and resolves the landing destination." },
    { "sourceType": "test", "reference": "tests/LagoVista.UserAdmin.Auth.Tests/PasswordLoginFlowIntegrationTests.cs", "note": "SuccessfulLogin_Should_ReturnAuthenticated_And_RecordStartedThenSucceeded proves the real successful path." }
  ]
}
