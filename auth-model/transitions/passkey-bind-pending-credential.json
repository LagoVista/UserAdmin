{
  "$schema": "../schemas/transition.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.transition.passkey.bind-pending-credential",
  "name": "Bind Pending Passkey Credential",
  "summary": "Atomically moves verified pending credential material onto the resolved durable user and resolves the PendingIdentity.",
  "version": 1,
  "maturity": "proposed",
  "priority": 85,
  "sourceState": { "expression": "pending-identity-status == resolution-required and pending-identity-flow == passkey and credential-proof == passkey-proved and durable-identity == resolved" },
  "actionKey": "auth.action.passkey.bind-pending-credential",
  "guards": [{ "expression": "input.durable-user-id matches resolved durable identity", "failureCode": "durable-identity-reference-mismatch" }],
  "destinationTransform": [
    { "dimensionKey": "auth.dimension.pending-identity-status", "operation": "set", "valueExpression": "resolved" }
  ],
  "requiredEffects": ["atomically-bind-passkey-credential-to-durable-user", "clear-pending-passkey-material"],
  "forbiddenEffects": ["create-second-durable-user", "bind-credential-to-different-user", "retain-duplicate-pending-credential"],
  "invariantKeys": ["auth.invariant.identity-resolution.no-duplicate-user", "auth.invariant.transition.one-state-changing-action", "auth.invariant.transition.deterministic-post-state"],
  "sourceReferences": [{ "sourceType": "discussion", "reference": "AUTH-MODEL-GUIDE.md", "section": "4.8" }]
}