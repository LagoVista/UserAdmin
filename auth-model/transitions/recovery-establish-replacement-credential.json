{
  "$schema": "../schemas/transition.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.transition.recovery.establish-replacement-credential",
  "name": "Establish Replacement Credential",
  "summary": "Moves proved recovery into credential-reset-required after a compliant replacement credential is established.",
  "version": 1,
  "maturity": "proposed",
  "priority": 100,
  "sourceState": { "expression": "recovery-state in [proved,credential-reset-required] and durable-identity == resolved" },
  "actionKey": "auth.action.recovery.establish-replacement-credential",
  "guards": [{ "expression": "replacement credential satisfies current policy", "failureCode": "replacement-credential-policy-failed" }],
  "destinationTransform": [
    { "dimensionKey": "auth.dimension.recovery-state", "operation": "set", "valueExpression": "credential-reset-required" },
    { "dimensionKey": "auth.dimension.credential-proof", "operation": "derive", "valueExpression": "replacement-credential-established" },
    { "dimensionKey": "auth.dimension.session-capability", "operation": "set", "valueExpression": "authenticated-limited" }
  ],
  "requiredEffects": ["persist-replacement-credential-atomically", "invalidate-superseded-recovery-material", "record-replacement-credential-established"],
  "forbiddenEffects": ["create-durable-user", "grant-normal-application-authorization", "change-home-workspace", "accept-invitation"],
  "invariantKeys": ["auth.invariant.recovery.existing-identity-only", "auth.invariant.transition.deterministic-post-state"],
  "sourceReferences": [{ "sourceType": "discussion", "reference": "AUTH-MODEL-GUIDE.md", "section": "4.14" }]
}