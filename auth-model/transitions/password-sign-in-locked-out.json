{
  "$schema": "../schemas/transition.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.transition.password-sign-in.locked-out",
  "name": "Password Sign-In Locked Out",
  "summary": "Records a password sign-in attempt blocked by account lockout while preserving the anonymous session and the existing lockout state.",
  "version": 1,
  "maturity": "implemented",
  "categoryKey": "password-sign-in",
  "priority": 95,
  "sourceState": { "expression": "session-capability == anonymous and account-status == locked-out" },
  "actionKey": "auth.action.password-sign-in.submit",
  "guards": [
    { "expression": "password authentication reports account lockout", "failureCode": "password-sign-in-not-locked-out" }
  ],
  "destinationTransform": [
    { "dimensionKey": "auth.dimension.session-capability", "operation": "derive", "valueExpression": "anonymous" }
  ],
  "requiredEffects": ["preserve-anonymous-session", "preserve-account-lockout-state", "return-lockout-specific-authentication-result", "record-password-authentication-failure"],
  "forbiddenEffects": ["issue-authenticated-session", "create-durable-user", "change-password-credential", "clear-account-lockout"],
  "invariantKeys": ["auth.invariant.transition.one-state-changing-action", "auth.invariant.transition.deterministic-post-state"],
  "sourceReferences": [
    { "sourceType": "code", "reference": "src/LagoVista.UserAdmin/Authentication/Flows/PasswordLoginFlowHandler.cs", "note": "Maps AUTH030 lockout results to this canonical transition." },
    { "sourceType": "code", "reference": "src/LagoVista.AspNetCore.Identity/Managers/SigninManager.cs", "note": "SignInResult.IsLockedOut returns AUTH030 and records PasswordAuthenticationFailed without establishing a session." },
    { "sourceType": "test", "reference": "tests/LagoVista.UserAdmin.Auth.Tests/PasswordLoginFlowIntegrationTests.cs", "note": "LockedOut_Should_ReturnLockoutResult_And_RecordStartedThenFailed proves the real lockout branch." }
  ]
}
