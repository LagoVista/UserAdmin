{
  "$schema": "../schemas/transition.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.transition.password.verify-email",
  "name": "Verify Password Registration Email",
  "summary": "Consumes the active email proof and records verified ownership for the password PendingIdentity.",
  "version": 1,
  "maturity": "proposed",
  "priority": 80,
  "sourceState": { "expression": "pending-identity-status in [verification-required,verifying] and pending-identity-flow == password and email-ownership == verification-pending" },
  "actionKey": "auth.action.password.verify-email",
  "guards": [{ "expression": "input.verification-proof is valid, unexpired, unused, and bound to the PendingIdentity", "failureCode": "invalid-email-verification-proof" }],
  "destinationTransform": [
    { "dimensionKey": "auth.dimension.email-ownership", "operation": "set", "valueExpression": "verified" },
    { "dimensionKey": "auth.dimension.pending-identity-status", "operation": "set", "valueExpression": "resolution-required" }
  ],
  "requiredEffects": ["consume-email-verification-proof", "record-email-ownership-verified"],
  "forbiddenEffects": ["reuse-verification-proof", "create-durable-user", "grant-normal-application-authorization"],
  "invariantKeys": ["auth.invariant.pending-identity.no-normal-authorization", "auth.invariant.pending-identity.exactly-one-flow", "auth.invariant.email-identities.not-conflated", "auth.invariant.transition.one-state-changing-action", "auth.invariant.transition.deterministic-post-state"],
  "sourceReferences": [{ "sourceType": "discussion", "reference": "AUTH-MODEL-GUIDE.md", "section": "4.6" }]
}