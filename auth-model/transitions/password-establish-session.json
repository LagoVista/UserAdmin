{
  "$schema": "../schemas/transition.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.transition.password.establish-session",
  "name": "Establish Password Registration Session",
  "summary": "Completes the PendingIdentity and establishes a normal authenticated session in the home workspace.",
  "version": 1,
  "maturity": "proposed",
  "priority": 30,
  "sourceState": { "expression": "pending-identity-status == resolution-required and pending-identity-flow == password and durable-identity == resolved and account-status == active and home-workspace == established and workspace-membership == home-only and current-workspace == home" },
  "actionKey": "auth.action.password.establish-session",
  "guards": [{ "expression": "input.durable-identity-reference matches the resolved durable identity", "failureCode": "durable-identity-reference-mismatch" }],
  "destinationTransform": [
    { "dimensionKey": "auth.dimension.pending-identity-status", "operation": "set", "valueExpression": "resolved" },
    { "dimensionKey": "auth.dimension.pending-identity-flow", "operation": "set", "valueExpression": "none" },
    { "dimensionKey": "auth.dimension.session-capability", "operation": "derive", "valueExpression": "authenticated-normal" }
  ],
  "requiredEffects": ["issue-authenticated-session", "record-password-registration-completed"],
  "forbiddenEffects": ["create-durable-user", "create-home-workspace", "consume-workspace-invitation"],
  "invariantKeys": ["auth.invariant.registration.completes-in-home-workspace", "auth.invariant.current-workspace.requires-access", "auth.invariant.transition.one-state-changing-action", "auth.invariant.transition.deterministic-post-state"],
  "sourceReferences": [{ "sourceType": "discussion", "reference": "AUTH-MODEL-GUIDE.md", "section": "4.6" }]
}