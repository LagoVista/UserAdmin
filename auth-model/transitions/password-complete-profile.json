{
  "$schema": "../schemas/transition.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.transition.password.complete-profile",
  "name": "Complete Password Registration Profile",
  "summary": "Marks the password registration profile complete after required values pass validation.",
  "version": 1,
  "maturity": "proposed",
  "priority": 70,
  "sourceState": { "expression": "pending-identity-status == resolution-required and pending-identity-flow == password and email-ownership == verified and profile-completeness in [unknown,incomplete]" },
  "actionKey": "auth.action.password.complete-profile",
  "guards": [{ "expression": "input.profile contains all required valid values", "failureCode": "registration-profile-incomplete" }],
  "destinationTransform": [
    { "dimensionKey": "auth.dimension.profile-completeness", "operation": "set", "valueExpression": "complete" }
  ],
  "requiredEffects": ["validate-registration-profile", "persist-registration-profile"],
  "forbiddenEffects": ["create-durable-user", "establish-password", "grant-normal-application-authorization"],
  "invariantKeys": ["auth.invariant.pending-identity.no-normal-authorization", "auth.invariant.pending-identity.exactly-one-flow", "auth.invariant.transition.one-state-changing-action", "auth.invariant.transition.deterministic-post-state"],
  "sourceReferences": [{ "sourceType": "discussion", "reference": "AUTH-MODEL-GUIDE.md", "section": "4.6" }]
}