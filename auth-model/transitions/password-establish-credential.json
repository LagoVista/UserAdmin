{
  "$schema": "../schemas/transition.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.transition.password.establish-credential",
  "name": "Establish Password Credential",
  "summary": "Establishes password proof after verified email and profile completion without resolving the durable user.",
  "version": 1,
  "maturity": "proposed",
  "priority": 60,
  "sourceState": { "expression": "pending-identity-status == resolution-required and pending-identity-flow == password and email-ownership == verified and profile-completeness == complete and credential-proof == none" },
  "actionKey": "auth.action.password.establish-credential",
  "guards": [{ "expression": "input.password-secret satisfies password policy and secure-channel requirements", "failureCode": "password-policy-failed" }],
  "destinationTransform": [
    { "dimensionKey": "auth.dimension.credential-proof", "operation": "set", "valueExpression": "password-proved" },
    { "dimensionKey": "auth.dimension.durable-identity", "operation": "set", "valueExpression": "creation-required" }
  ],
  "requiredEffects": ["validate-password-policy", "persist-password-credential", "record-password-established"],
  "forbiddenEffects": ["persist-plaintext-password", "create-durable-user", "create-home-workspace", "grant-normal-application-authorization"],
  "invariantKeys": ["auth.invariant.pending-identity.no-normal-authorization", "auth.invariant.pending-identity.exactly-one-flow", "auth.invariant.transition.one-state-changing-action", "auth.invariant.transition.deterministic-post-state"],
  "sourceReferences": [{ "sourceType": "discussion", "reference": "AUTH-MODEL-GUIDE.md", "section": "4.6" }]
}