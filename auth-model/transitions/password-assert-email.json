{
  "$schema": "../schemas/transition.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.transition.password.assert-email",
  "name": "Assert Password Registration Email",
  "summary": "Records an asserted email and moves the password PendingIdentity into email verification.",
  "version": 1,
  "maturity": "proposed",
  "priority": 90,
  "sourceState": { "expression": "pending-identity-status == pending and pending-identity-flow == password and email-ownership in [unknown,asserted]" },
  "actionKey": "auth.action.password.assert-email",
  "guards": [{ "expression": "input.email is syntactically valid and normalized", "failureCode": "invalid-email" }],
  "destinationTransform": [
    { "dimensionKey": "auth.dimension.email-ownership", "operation": "set", "valueExpression": "verification-pending" },
    { "dimensionKey": "auth.dimension.pending-identity-status", "operation": "set", "valueExpression": "verification-required" }
  ],
  "requiredEffects": ["persist-asserted-email", "issue-email-verification-challenge", "record-password-email-asserted"],
  "forbiddenEffects": ["mark-email-verified", "create-durable-user", "grant-normal-application-authorization"],
  "invariantKeys": ["auth.invariant.pending-identity.no-normal-authorization", "auth.invariant.pending-identity.exactly-one-flow", "auth.invariant.email-identities.not-conflated", "auth.invariant.transition.one-state-changing-action", "auth.invariant.transition.deterministic-post-state"],
  "sourceReferences": [{ "sourceType": "discussion", "reference": "AUTH-MODEL-GUIDE.md", "section": "4.6" }]
}