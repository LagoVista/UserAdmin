{
  "$schema": "../schemas/transition.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.transition.passkey.remove-existing-user-credential",
  "name": "Remove Existing User Passkey Credential",
  "summary": "Deletes one passkey credential from the current durable identity while preserving the authenticated session and all other credentials.",
  "version": 1,
  "maturity": "proposed",
  "priority": 55,
  "sourceState": { "expression": "durable-identity == resolved and session-capability in [authenticated-limited,authenticated-normal,step-up]" },
  "actionKey": "auth.action.passkey.remove-existing-user-credential",
  "guards": [
    { "expression": "selected credential belongs to the current durable identity and current relying party", "failureCode": "passkey-credential-not-owned" }
  ],
  "destinationTransform": [],
  "requiredEffects": ["delete-selected-passkey-credential-for-current-user"],
  "forbiddenEffects": ["delete-passkey-for-different-user", "change-durable-identity", "change-session-capability"],
  "invariantKeys": ["auth.invariant.transition.one-state-changing-action", "auth.invariant.transition.deterministic-post-state"],
  "sourceReferences": [
    { "sourceType": "code", "reference": "src/LagoVista.AspNetCore.Identity/Managers/AppUserPasskeyManager.cs", "note": "Passkey removal is scoped to the current user and relying party." }
  ]
}
