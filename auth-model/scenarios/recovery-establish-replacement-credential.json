{
  "$schema": "../schemas/scenario.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.scenario.recovery.establish-replacement-credential",
  "name": "Establish Replacement Credential",
  "summary": "Establishes a replacement credential for the recovered existing identity while normal access remains blocked.",
  "version": 1,
  "maturity": "proposed",
  "scenarioType": "integration",
  "journeyKeys": ["auth.journey.account-recovery"],
  "transitionKey": "auth.transition.recovery.establish-replacement-credential",
  "preconditions": { "expression": "recovery-state in [proved,credential-reset-required] and durable-identity == resolved" },
  "setup": ["Complete approved recovery proof for an existing durable identity."],
  "inputs": [
    { "key": "recovery-reference", "valueType": "reference", "required": true, "example": "recovery-record" },
    { "key": "replacement-credential-reference", "valueType": "reference", "required": true, "example": "secure-credential-result" }
  ],
  "actionKey": "auth.action.recovery.establish-replacement-credential",
  "postconditions": { "expression": "recovery-state == credential-reset-required and replacement-credential-established == true and session-capability == authenticated-limited" },
  "requiredEffects": ["persist-replacement-credential-atomically", "invalidate-superseded-recovery-material", "record-replacement-credential-established"],
  "forbiddenEffects": ["create-durable-user", "grant-normal-application-authorization", "change-home-workspace", "accept-invitation"],
  "invariantKeys": ["auth.invariant.recovery.existing-identity-only", "auth.invariant.transition.deterministic-post-state"],
  "expectedAuthLogEvents": ["replacement-credential-established"],
  "evidenceRequirements": ["server", "web", "android", "ios", "vtm"],
  "sourceReferences": [{ "sourceType": "discussion", "reference": "AUTH-MODEL-GUIDE.md", "section": "4.14" }]
}