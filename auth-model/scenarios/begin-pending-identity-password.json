{
  "$schema": "../schemas/scenario.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.scenario.pending-identity.begin-password",
  "name": "Begin Password Pending Identity",
  "summary": "Creates one password PendingIdentity and restricts the session to the identity ceremony.",
  "version": 1,
  "maturity": "proposed",
  "scenarioType": "integration",
  "journeyKeys": ["auth.journey.pending-identity.lifecycle"],
  "transitionKey": "auth.transition.pending-identity.begin",
  "preconditions": { "expression": "pending-identity-status == none and pending-identity-flow == none and durable-identity == absent" },
  "setup": [],
  "inputs": [
    { "key": "flow", "valueType": "string", "required": true, "example": "password" },
    { "key": "ceremony-reference", "valueType": "reference", "required": true }
  ],
  "actionKey": "auth.action.pending-identity.begin",
  "postconditions": { "expression": "pending-identity-status == pending and pending-identity-flow == password and session-capability == identity-ceremony" },
  "requiredEffects": ["persist-single-flow-bucket", "record-pending-identity-begun"],
  "forbiddenEffects": ["create-durable-user", "grant-normal-application-authorization", "populate-multiple-flow-buckets"],
  "invariantKeys": ["auth.invariant.pending-identity.no-normal-authorization", "auth.invariant.pending-identity.exactly-one-flow"],
  "expectedAuthLogEvents": ["pending-identity-begun"],
  "evidenceRequirements": ["server", "web", "android", "ios", "vtm"],
  "sourceReferences": [{ "sourceType": "discussion", "reference": "AUTH-MODEL-GUIDE.md", "section": "4.5" }]
}