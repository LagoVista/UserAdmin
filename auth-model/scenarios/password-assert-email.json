{
  "$schema": "../schemas/scenario.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.scenario.password.assert-email",
  "name": "Assert Password Registration Email",
  "summary": "Records the registration email and requires ownership verification without treating the assertion as proof.",
  "version": 1,
  "maturity": "proposed",
  "scenarioType": "integration",
  "journeyKeys": ["auth.journey.password.registration"],
  "transitionKey": "auth.transition.password.assert-email",
  "preconditions": { "expression": "pending-identity-status == pending and pending-identity-flow == password and email-ownership in [unknown,asserted]" },
  "setup": [],
  "inputs": [{ "key": "email", "valueType": "string", "required": true, "example": "person@example.com" }],
  "actionKey": "auth.action.password.assert-email",
  "postconditions": { "expression": "email-ownership == verification-pending and pending-identity-status == verification-required and session-capability == identity-ceremony" },
  "requiredEffects": ["persist-asserted-email", "issue-email-verification-challenge", "record-password-email-asserted"],
  "forbiddenEffects": ["mark-email-verified", "create-durable-user", "grant-normal-application-authorization"],
  "invariantKeys": ["auth.invariant.pending-identity.no-normal-authorization", "auth.invariant.email-identities.not-conflated"],
  "expectedAuthLogEvents": ["password-email-asserted"],
  "evidenceRequirements": ["server", "web", "android", "ios", "vtm"],
  "sourceReferences": [{ "sourceType": "discussion", "reference": "AUTH-MODEL-GUIDE.md", "section": "4.6" }]
}