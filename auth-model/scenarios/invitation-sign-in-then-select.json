{
  "$schema": "../schemas/scenario.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.scenario.invitation.sign-in-then-select",
  "name": "Sign In Then Select Invitation Identity",
  "summary": "Preserves a valid invitation while a logged-out person signs into an existing account and explicitly selects that durable identity.",
  "version": 1,
  "maturity": "proposed",
  "scenarioType": "composite",
  "journeyKeys": ["auth.journey.invitation.resolve"],
  "transitionKey": "auth.transition.invitation.select-identity",
  "preconditions": { "expression": "invitation-status == valid and durable-identity == absent" },
  "setup": ["Preserve only the invitation reference while standard authentication completes."],
  "inputs": [{ "key": "selected-durable-identity-reference", "valueType": "reference", "required": true, "description": "Existing durable identity authenticated by the person." }],
  "actionKey": "auth.action.invitation.select-identity",
  "postconditions": { "expression": "invitation-status == acceptance-pending and durable-identity == resolved" },
  "requiredEffects": ["preserve-invitation-context-across-authentication", "present-acceptance-summary"],
  "forbiddenEffects": ["treat-invitation-as-authentication", "auto-accept-invitation", "change-home-workspace"],
  "invariantKeys": ["auth.invariant.invitation.not-identity-proof", "auth.invariant.invitation.requires-selected-identity"],
  "expectedAuthLogEvents": ["invitation-identity-selected"],
  "evidenceRequirements": ["server", "web", "android", "ios", "vtm"],
  "sourceReferences": [{ "sourceType": "discussion", "reference": "AUTH-MODEL-GUIDE.md", "section": "4.10" }]
}