{
  "$schema": "../schemas/scenario.schema.json",
  "schemaVersion": "1.0",
  "key": "auth.scenario.passkey.bind-pending-credential",
  "name": "Bind Pending Passkey Credential",
  "summary": "Atomically binds verified pending passkey credential material to the resolved durable user.",
  "version": 1,
  "maturity": "proposed",
  "scenarioType": "integration",
  "journeyKeys": ["auth.journey.passkey.new-user-registration"],
  "transitionKey": "auth.transition.passkey.bind-pending-credential",
  "preconditions": { "expression": "pending-identity-status == resolution-required and credential-proof == passkey-proved and durable-identity == resolved" },
  "setup": ["Create or explicitly resolve the durable identity before credential binding."],
  "inputs": [{ "key": "durable-user-id", "valueType": "reference", "required": true, "description": "Resolved durable identity selected for the credential." }],
  "actionKey": "auth.action.passkey.bind-pending-credential",
  "postconditions": { "expression": "durable-identity == resolved and pending-identity-status == resolved" },
  "requiredEffects": ["atomically-bind-passkey-credential-to-durable-user", "clear-pending-passkey-material"],
  "forbiddenEffects": ["create-duplicate-user", "bind-credential-to-different-user", "retain-duplicate-pending-credential"],
  "invariantKeys": ["auth.invariant.identity-resolution.no-duplicate-user"],
  "expectedAuthLogEvents": ["passkey-credential-bound"],
  "evidenceRequirements": ["server", "web", "android", "ios", "vtm"],
  "sourceReferences": [{ "sourceType": "discussion", "reference": "AUTH-MODEL-GUIDE.md", "section": "4.8" }]
}