{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lagovista.com/auth-model/schemas/conversation-type.schema.json",
  "title": "Authentication Conversation Type",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "key",
    "name",
    "summary",
    "version",
    "maturity",
    "goals",
    "supportedJourneyKeys",
    "entryPredicate",
    "completionPredicate",
    "informationRequirements",
    "allowedActionKeys",
    "prohibitedActionKeys",
    "decisionPoints",
    "confirmationRequirements",
    "secureInteractions",
    "escalationConditions",
    "lifecycle",
    "supportedChannels",
    "presentationExpectations",
    "scenarioKeys",
    "sourceReferences"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "key": {
      "type": "string",
      "pattern": "^auth\\.conversation\\.[a-z][a-z0-9-]{1,63}(\\.[a-z][a-z0-9-]{1,63})*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "maturity": {
      "enum": ["proposed", "reviewed", "approved", "implemented", "verified", "deprecated"]
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "summary"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "supportedJourneyKeys": {
      "type": "array",
      "items": { "type": "string", "pattern": "^auth\\.journey\\." },
      "uniqueItems": true
    },
    "entryPredicate": { "$ref": "#/$defs/predicate" },
    "completionPredicate": { "$ref": "#/$defs/predicate" },
    "informationRequirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "summary", "sensitivity", "collection"],
        "properties": {
          "key": { "type": "string" },
          "summary": { "type": "string" },
          "sensitivity": { "enum": ["public", "profile", "sensitive", "secret"] },
          "collection": { "enum": ["conversation", "secure-component", "derived", "existing-state"] },
          "requiredForGoalKeys": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "allowedActionKeys": {
      "type": "array",
      "items": { "type": "string", "pattern": "^auth\\.action\\." },
      "uniqueItems": true
    },
    "prohibitedActionKeys": {
      "type": "array",
      "items": { "type": "string", "pattern": "^auth\\.action\\." },
      "uniqueItems": true
    },
    "decisionPoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "summary", "basis"],
        "properties": {
          "key": { "type": "string" },
          "summary": { "type": "string" },
          "basis": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "confirmationRequirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "summary", "requiredBeforeActionKeys"],
        "properties": {
          "key": { "type": "string" },
          "summary": { "type": "string" },
          "requiredBeforeActionKeys": {
            "type": "array",
            "items": { "type": "string", "pattern": "^auth\\.action\\." }
          }
        }
      }
    },
    "secureInteractions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "summary",
          "componentType",
          "conversationMayProvide",
          "componentCollects",
          "sanitizedOutcomes",
          "resumeBehavior"
        ],
        "properties": {
          "key": { "type": "string" },
          "summary": { "type": "string" },
          "componentType": { "type": "string" },
          "conversationMayProvide": { "type": "array", "items": { "type": "string" } },
          "componentCollects": { "type": "array", "items": { "type": "string" } },
          "sanitizedOutcomes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "resumeBehavior": { "type": "string" }
        }
      }
    },
    "escalationConditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "condition", "outcome"],
        "properties": {
          "key": { "type": "string" },
          "condition": { "type": "string" },
          "outcome": { "type": "string" }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pause", "resume", "abandonment", "expiration"],
      "properties": {
        "pause": { "type": "string" },
        "resume": { "type": "string" },
        "abandonment": { "type": "string" },
        "expiration": { "type": "string" }
      }
    },
    "supportedChannels": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["web", "android", "ios", "vtm", "voice"] },
      "uniqueItems": true
    },
    "presentationExpectations": { "type": "array", "items": { "type": "string" } },
    "scenarioKeys": {
      "type": "array",
      "items": { "type": "string", "pattern": "^auth\\.scenario\\." },
      "uniqueItems": true
    },
    "openQuestions": { "type": "array", "items": { "type": "string" } },
    "sourceReferences": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceReference" }
    }
  },
  "$defs": {
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression"],
      "properties": { "expression": { "type": "string", "minLength": 1 } }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceType", "reference"],
      "properties": {
        "sourceType": { "enum": ["ddr", "code", "test", "discussion", "decision", "external"] },
        "reference": { "type": "string", "minLength": 1 },
        "section": { "type": "string" },
        "commit": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}