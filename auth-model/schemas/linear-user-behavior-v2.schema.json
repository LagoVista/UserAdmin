{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lagovista.com/schemas/auth-model/linear-user-behavior-v2.schema.json",
  "title": "Linear User Behavior",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "key",
    "name",
    "summary",
    "version",
    "maturity",
    "categoryKey",
    "scenarioKeys",
    "entryViewKey",
    "finalViewKey",
    "finalOutcome",
    "supportedPlatforms",
    "sourceReferences"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "2.0" },
    "key": { "type": "string", "pattern": "^auth\\.behavior\\.[a-z][a-z0-9-]{1,63}(\\.[a-z][a-z0-9-]{1,63})*$" },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "maturity": { "enum": ["proposed", "reviewed", "approved", "implemented", "verified", "deprecated"] },
    "categoryKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "scenarioKeys": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^auth\\.scenario\\." }
    },
    "entryViewKey": { "$ref": "#/$defs/viewKey" },
    "finalViewKey": { "$ref": "#/$defs/viewKey" },
    "finalOutcome": { "type": "string", "minLength": 1 },
    "supportedPlatforms": { "type": "array", "uniqueItems": true, "items": { "enum": ["server", "web", "android", "ios", "vtm"] } },
    "sourceReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceType", "reference"],
        "properties": {
          "sourceType": { "enum": ["ddr", "code", "test", "discussion", "decision", "auth-view", "external"] },
          "reference": { "type": "string", "minLength": 1 },
          "section": { "type": "string" },
          "commit": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "definitionHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "viewKey": { "type": "string", "pattern": "^(auth|app)\\.[a-z][a-z0-9-]{1,63}(\\.[a-z][a-z0-9-]{1,63})*$" }
  }
}
