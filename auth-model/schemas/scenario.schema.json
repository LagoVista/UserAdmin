{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lagovista.com/schemas/auth-model/scenario.schema.json",
  "title": "Authentication Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "key", "name", "summary", "version", "maturity", "scenarioType", "preconditions", "inputs", "actionKey", "postconditions", "requiredEffects", "forbiddenEffects", "invariantKeys", "evidenceRequirements", "sourceReferences"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "key": { "type": "string", "pattern": "^auth\\.scenario\\.[a-z][a-z0-9-]{1,63}(\\.[a-z][a-z0-9-]{1,63})*$" },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "maturity": { "$ref": "#/$defs/maturity" },
    "categoryKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "scenarioType": { "enum": ["server", "ui", "composite", "conversation", "security-invariant", "recovery", "integration"] },
    "journeyKeys": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^auth\\.journey\\." } },
    "transitionKey": { "type": ["string", "null"], "pattern": "^auth\\.transition\\." },
    "preconditions": { "$ref": "#/$defs/stateAssertion" },
    "setup": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/input" } },
    "actionKey": { "type": "string", "pattern": "^auth\\.action\\." },
    "postconditions": { "$ref": "#/$defs/stateAssertion" },
    "requiredEffects": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "forbiddenEffects": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "invariantKeys": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^auth\\.invariant\\." } },
    "expectedAuthLogEvents": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "presentationExpectation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startViewKey": { "type": "string" },
        "expectedViewKey": { "type": "string" },
        "requiredActionKey": { "type": "string" },
        "recommendedActionKey": { "type": "string" }
      }
    },
    "evidenceRequirements": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["server", "web", "android", "ios", "vtm"] }
    },
    "sourceReferences": { "type": "array", "items": { "$ref": "#/$defs/sourceReference" } },
    "definitionHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "maturity": { "enum": ["proposed", "reviewed", "approved", "implemented", "verified", "deprecated"] },
    "stateAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression"],
      "properties": {
        "expression": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "valueType", "required"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
        "valueType": { "enum": ["string", "boolean", "integer", "timestamp", "reference", "secret-reference", "object"] },
        "required": { "type": "boolean" },
        "example": {},
        "description": { "type": "string" }
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceType", "reference"],
      "properties": {
        "sourceType": { "enum": ["ddr", "code", "test", "discussion", "decision", "external"] },
        "reference": { "type": "string", "minLength": 1 },
        "section": { "type": "string" },
        "commit": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}