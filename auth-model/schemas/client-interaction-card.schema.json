{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lagovista.com/client-interaction-card.schema.json",
  "title": "Client Interaction Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "key",
    "name",
    "summary",
    "version",
    "maturity",
    "cardType",
    "directiveKey",
    "outcomes",
    "responseContract",
    "platforms"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "key": { "$ref": "#/$defs/definitionKey" },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "version": { "type": "integer", "minimum": 1 },
    "maturity": { "$ref": "#/$defs/maturity" },
    "cardType": { "enum": ["general", "auth"] },
    "directiveKey": { "$ref": "#/$defs/directiveKey" },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "payloadMode": { "enum": ["none", "typed"] },
        "payloadSchemaReference": { "type": "string", "minLength": 1 },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "controls": {
      "type": "array",
      "items": { "$ref": "#/$defs/control" }
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "presentationStates": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/outcome" }
    },
    "responseContract": { "$ref": "#/$defs/responseContract" },
    "platforms": { "$ref": "#/$defs/platforms" },
    "sourceReferences": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceReference" }
    }
  },
  "$defs": {
    "definitionKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}(\\.[a-z][a-z0-9-]{1,63})+$"
    },
    "directiveKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 96
    },
    "maturity": {
      "enum": ["proposed", "reviewed", "approved", "implemented", "verified", "deprecated"]
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "controlType", "finder"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "controlType": {
          "enum": ["text-input", "email-input", "password-input", "code-input", "checkbox", "select", "multi-select", "label", "status", "display", "qr-code", "secret-display", "copyable-value", "native-capability"]
        },
        "finder": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "sensitivity": { "enum": ["public", "personal", "credential", "secret"] }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "actionType", "finder"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "actionType": { "enum": ["button", "link", "native-capability"] },
        "finder": { "type": "string", "minLength": 1 }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "terminal"],
      "properties": {
        "key": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "terminal": { "const": true }
      }
    },
    "responseContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowValue", "allowedValueShapes"],
      "properties": {
        "allowValue": { "type": "boolean" },
        "allowedValueShapes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["string", "boolean", "number", "entity-header", "multi-select-string", "multi-select-boolean", "multi-select-number", "multi-select-entity-header"]
          }
        },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["angularWeb", "reactNative"],
      "properties": {
        "angularWeb": { "$ref": "#/$defs/platformSupport" },
        "reactNative": { "$ref": "#/$defs/platformSupport" }
      }
    },
    "platformSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["implemented", "partial", "planned", "unsupported", "not-applicable"] },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "path": { "type": "string", "minLength": 1 },
        "component": { "type": "string", "minLength": 1 },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceType", "reference"],
      "properties": {
        "sourceType": { "enum": ["ddr", "code", "test", "discussion", "decision", "external"] },
        "reference": { "type": "string", "minLength": 1 },
        "section": { "type": "string" },
        "commit": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
