{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lagovista.com/schemas/auth-model/invariant.schema.json",
  "title": "Authentication Invariant",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "key", "name", "summary", "version", "maturity", "kind", "appliesWhen", "rule", "failureMeaning", "sourceReferences"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "key": { "type": "string", "pattern": "^auth\\.invariant\\.[a-z][a-z0-9-]{1,63}(\\.[a-z][a-z0-9-]{1,63})*$" },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "maturity": { "$ref": "#/$defs/maturity" },
    "kind": { "enum": ["state", "transition", "side-effect"] },
    "severity": { "enum": ["error", "warning"], "default": "error" },
    "appliesWhen": { "$ref": "#/$defs/predicate" },
    "rule": { "type": "string", "minLength": 1 },
    "failureMeaning": { "type": "string", "minLength": 1 },
    "relatedDimensionKeys": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/dimensionKeyReference" } },
    "sourceReferences": { "type": "array", "items": { "$ref": "#/$defs/sourceReference" } },
    "definitionHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "maturity": { "enum": ["proposed", "reviewed", "approved", "implemented", "verified", "deprecated"] },
    "dimensionKeyReference": { "type": "string", "pattern": "^auth\\.dimension\\.[a-z][a-z0-9-]{1,63}(\\.[a-z][a-z0-9-]{1,63})*$" },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression"],
      "properties": {
        "expression": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceType", "reference"],
      "properties": {
        "sourceType": { "enum": ["ddr", "code", "test", "discussion", "decision", "external"] },
        "reference": { "type": "string", "minLength": 1 },
        "section": { "type": "string" },
        "commit": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
