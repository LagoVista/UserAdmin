{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lagovista.com/schemas/auth-model/action.schema.json",
  "title": "Authentication Action",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "key", "name", "summary", "version", "maturity", "requiredInputs", "guards", "permittedMutations", "requiredEffects", "forbiddenEffects", "invariantKeys", "sourceReferences"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "key": { "type": "string", "pattern": "^auth\\.action\\.[a-z][a-z0-9-]{1,63}(\\.[a-z][a-z0-9-]{1,63})*$" },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "maturity": { "$ref": "#/$defs/maturity" },
    "requiredInputs": { "type": "array", "items": { "$ref": "#/$defs/input" } },
    "guards": { "type": "array", "items": { "$ref": "#/$defs/predicate" } },
    "permittedMutations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/keyReference" } },
    "requiredEffects": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "forbiddenEffects": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "invariantKeys": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^auth\\.invariant\\." } },
    "sourceReferences": { "type": "array", "items": { "$ref": "#/$defs/sourceReference" } },
    "definitionHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "maturity": { "enum": ["proposed", "reviewed", "approved", "implemented", "verified", "deprecated"] },
    "keyReference": { "type": "string", "pattern": "^auth\\.[a-z][a-z0-9-]{1,63}(\\.[a-z][a-z0-9-]{1,63})+$" },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "valueType", "required"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
        "valueType": { "enum": ["string", "boolean", "integer", "timestamp", "reference", "secret-reference", "object"] },
        "required": { "type": "boolean" },
        "description": { "type": "string" }
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression"],
      "properties": {
        "expression": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "failureCode": { "type": "string" }
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceType", "reference"],
      "properties": {
        "sourceType": { "enum": ["ddr", "code", "test", "discussion", "decision", "external"] },
        "reference": { "type": "string", "minLength": 1 },
        "section": { "type": "string" },
        "commit": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
