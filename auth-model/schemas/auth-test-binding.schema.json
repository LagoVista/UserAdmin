{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lagovista.com/schemas/auth-model/auth-test-binding.schema.json",
  "title": "Authentication Test Binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "key", "name", "summary", "version", "maturity", "testLevel", "repository", "projectPath", "sourcePath", "framework", "testTypeName", "testMethodNames", "handlerKeys", "endpointBindingKeys", "transitionKeys", "proofObligations", "sourceReferences"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "key": { "type": "string", "pattern": "^auth\\.test-binding\\.[a-z][a-z0-9-]{1,63}(\\.[a-z][a-z0-9-]{1,63})*$" },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "maturity": { "$ref": "#/$defs/maturity" },
    "testLevel": { "enum": ["flow-matrix", "handler-integration", "endpoint-integration", "ui-journey"] },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "projectPath": { "type": "string", "minLength": 1 },
    "sourcePath": { "type": "string", "minLength": 1 },
    "framework": { "type": "string", "minLength": 1 },
    "testTypeName": { "type": "string", "minLength": 1 },
    "testMethodNames": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "scenarioKeys": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^auth\\.scenario\\." } },
    "handlerKeys": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^auth\\.handler\\." } },
    "endpointBindingKeys": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^auth\\.endpoint\\." } },
    "transitionKeys": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^auth\\.transition\\." } },
    "proofObligations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "sourceReferences": { "type": "array", "items": { "$ref": "#/$defs/sourceReference" } },
    "definitionHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "maturity": { "enum": ["proposed", "reviewed", "approved", "implemented", "verified", "deprecated"] },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceType", "reference"],
      "properties": {
        "sourceType": { "enum": ["ddr", "code", "test", "discussion", "decision", "external"] },
        "reference": { "type": "string", "minLength": 1 },
        "section": { "type": "string" },
        "commit": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
