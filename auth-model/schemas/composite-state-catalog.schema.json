{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lagovista.com/schemas/auth-model/composite-state-catalog.schema.json",
  "title": "Authentication Composite State Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "key", "name", "summary", "version", "maturity", "regions", "dependencies", "sourceReferences"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "key": { "type": "string", "const": "auth.state.composite-catalog" },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "maturity": { "enum": ["proposed", "reviewed", "approved", "implemented", "verified", "deprecated"] },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name", "summary", "dimensionKeys"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
          "name": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "dimensionKeys": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^auth\\.dimension\\." } }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fromDimensionKey", "toDimensionKey", "relationship", "summary"],
        "properties": {
          "fromDimensionKey": { "type": "string", "pattern": "^auth\\.dimension\\." },
          "toDimensionKey": { "type": "string", "pattern": "^auth\\.dimension\\." },
          "relationship": { "enum": ["constrains", "requires", "derives", "selects", "claims", "authorizes"] },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sourceReferences": { "type": "array", "items": { "type": "object", "required": ["sourceType", "reference"], "properties": { "sourceType": { "enum": ["ddr", "code", "test", "discussion", "decision", "external"] }, "reference": { "type": "string" }, "section": { "type": "string" }, "commit": { "type": "string" }, "note": { "type": "string" } } } },
    "definitionHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}