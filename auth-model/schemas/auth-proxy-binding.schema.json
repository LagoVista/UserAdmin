{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lagovista.com/schemas/auth-model/auth-proxy-binding.schema.json",
  "title": "Authentication Generated Proxy Binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "key", "name", "summary", "version", "maturity", "endpointBindingKey", "operationContractId", "operationId", "repository", "sourcePath", "serviceType", "methodName", "requestContract", "resultContract", "generator", "consumingPlatforms", "sourceReferences"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "key": { "type": "string", "pattern": "^auth\\.proxy\\.[a-z][a-z0-9-]{1,63}(\\.[a-z][a-z0-9-]{1,63})*$" },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "maturity": { "enum": ["proposed", "reviewed", "approved", "implemented", "verified", "deprecated"] },
    "endpointBindingKey": { "type": "string", "pattern": "^auth\\.endpoint\\." },
    "operationContractId": { "type": "string", "pattern": "^nuvos\\.endpoint\\.[a-z0-9-]+\\.[a-z0-9-]+$" },
    "operationId": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "sourcePath": { "type": "string", "minLength": 1 },
    "serviceType": { "type": "string", "minLength": 1 },
    "methodName": { "type": "string", "minLength": 1 },
    "requestContract": { "type": "string", "minLength": 1 },
    "resultContract": { "type": "string", "minLength": 1 },
    "generator": { "type": "string", "minLength": 1 },
    "consumingPlatforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "sourceReferences": { "type": "array", "items": { "type": "object", "required": ["sourceType", "reference"], "properties": { "sourceType": { "enum": ["ddr", "code", "test", "discussion", "decision", "external"] }, "reference": { "type": "string", "minLength": 1 }, "note": { "type": "string" } }, "additionalProperties": false } }
  }
}
