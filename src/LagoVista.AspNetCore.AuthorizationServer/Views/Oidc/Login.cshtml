@model LagoVista.AspNetCore.AuthorizationServer.OidcLoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Sign in";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in</title>
    <style>
        :root { font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
        body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #f4f6f8; color: #17202a; }
        main { width: min(92vw, 420px); background: white; border-radius: 12px; box-shadow: 0 18px 50px rgba(0,0,0,.12); padding: 28px; }
        h1 { margin: 0 0 8px; font-size: 1.6rem; }
        p { margin: 0 0 24px; color: #5d6d7e; }
        label { display: block; margin-top: 16px; font-weight: 600; }
        input[type=email], input[type=password] { width: 100%; box-sizing: border-box; margin-top: 6px; padding: 11px 12px; border: 1px solid #c8d0d8; border-radius: 8px; font: inherit; }
        .remember { display: flex; gap: 8px; align-items: center; font-weight: 400; }
        button { width: 100%; margin-top: 22px; padding: 12px; border: 0; border-radius: 8px; font: inherit; font-weight: 700; cursor: pointer; background: #1f6feb; color: white; }
        .validation { margin-top: 16px; color: #b42318; }
        .field-validation-error { display: block; margin-top: 4px; color: #b42318; font-size: .9rem; }
        .secondary { margin-top: 18px; text-align: center; font-size: .92rem; color: #5d6d7e; }
    </style>
</head>
<body>
    <main>
        <h1>Sign in to continue</h1>
        <p>Use your NuvIoT account to complete this authorization request.</p>

        <form method="post" action="/oidc/login">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.ReturnUrl)

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="validation">@Html.ValidationSummary(true)</div>
            }

            <label for="Email">Email</label>
            @Html.TextBoxFor(m => m.Email, new { type = "email", autocomplete = "username", autofocus = "autofocus" })
            @Html.ValidationMessageFor(m => m.Email)

            <label for="Password">Password</label>
            @Html.PasswordFor(m => m.Password, new { autocomplete = "current-password" })
            @Html.ValidationMessageFor(m => m.Password)

            <label class="remember">
                @Html.CheckBoxFor(m => m.RememberMe)
                <span>Keep me signed in</span>
            </label>

            <button type="submit">Continue</button>
        </form>

        <div class="secondary">
            This authorization surface intentionally supports only NuvIoT authentication methods.
        </div>
    </main>
</body>
</html>
